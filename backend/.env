# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/study-planner
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/study-planner
MONGO_URI=mongodb://sarajitsarkar60530_db_user:3JImxWowk2JqSfuF@ac-lbblsz9-shard-00-00.wejwwyi.mongodb.net:27017,ac-lbblsz9-shard-00-01.wejwwyi.mongodb.net:27017,ac-lbblsz9-shard-00-02.wejwwyi.mongodb.net:27017/?ssl=true&replicaSet=atlas-s47mk9-shard-0&authSource=admin&appName=Cluster0

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI (optional)
# If left empty, the app automatically falls back to a built-in
# rule-based scheduler and suggestion engine, so the app still works
# fully without an API key.
OPENAI_API_KEY=AQ.Ab8RN6I3DRUTzZhu34ObKKFK3EQbs6iHGn_QzTMsL69Gs9a-jA

# Frontend origin(s) allowed to call this API (for CORS).
# Also used to build the password reset link sent to users (the first one listed).
# Can be a single URL, or a comma-separated list if you access the app from
# more than one address (e.g. localhost AND 127.0.0.1, or local + deployed):
# CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CLIENT_ORIGIN=http://localhost:5173

# SMTP (optional) — used to email password reset links.
# If left empty, reset links are printed to the backend console instead,
# so the "forgot password" flow still works fully in local development.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<an app password, not your normal password>
SMTP_HOST=
SMTP_PORT=587
# Optional: force true/false if auto-detection from the port guesses wrong.
# Try SMTP_PORT=465 + SMTP_SECURE=true if 587 keeps failing, or vice versa.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
